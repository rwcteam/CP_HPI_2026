<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd" id="WebApp_ID" version="3.0">
  <display-name>CustomerPortal</display-name>

	<welcome-file-list>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>home.htm</welcome-file>
		<welcome-file>login.jsp</welcome-file>
	</welcome-file-list>


	<servlet>
		<servlet-name>UserLoginServlet</servlet-name>
		<servlet-class>com.etechlogix.distribution.ad.servlet.UserLoginServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>UserLoginServlet</servlet-name>
		<url-pattern>/login</url-pattern>
	</servlet-mapping>

	<servlet>   
		<servlet-name>UploadFileTest</servlet-name>
		<jsp-file>/customerPortal/A_CP_FileUploadTestAction.jsp</jsp-file>
		<multipart-config>
			<max-file-size>20848820</max-file-size>
			<max-request-size>418018841</max-request-size>
			<file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
	</servlet>
	<servlet-mapping>
		<servlet-name>UploadFileTest</servlet-name>
		<url-pattern>/customerPortal/UploadFile</url-pattern>
	</servlet-mapping>


	<servlet>   
		<servlet-name>Shop</servlet-name>
		<jsp-file>/customerPortal/A_CP_ShopAction.jsp</jsp-file>
		<multipart-config>
			<max-file-size>20848820</max-file-size>
			<max-request-size>418018841</max-request-size>
			<file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
	</servlet>
	<servlet-mapping>
		<servlet-name>Shop</servlet-name>
		<url-pattern>/customerPortal/ShopAction</url-pattern>
	</servlet-mapping>

	<session-config>
		<session-timeout>60</session-timeout>
	</session-config>


</web-app>